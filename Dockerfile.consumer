# Consumer service for window aggregation
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy consumer script
COPY consumer.py .

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ENV DB_HOST=envdb
ENV DB_PORT=5432
ENV DB_NAME=envdb
ENV DB_USER=env_admin
ENV DB_PASSWORD=env_admin123

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import psycopg2; psycopg2.connect(host='${DB_HOST}', port=${DB_PORT}, database='${DB_NAME}', user='${DB_USER}', password='${DB_PASSWORD}')" || exit 1

# Run consumer
CMD ["python", "consumer.py"]
