{
  "type": "Python",
  "sparkVersion": "4.0.0",
  "mainApplicationFile": "local:///opt/spark/examples/src/main/python/pi.py",
  "mode": "cluster",
  "image": "py-spark-spark",
  "imagePullPolicy": "IfNotPresent",
  "deps": {
    "jars": []
  },
  "restartPolicy": {
    "type": "OnFailure",
    "onFailureRetries": 5,
    "onFailureRetryInterval": 60,
    "onSubmissionFailureRetries": 10,
    "onSubmissionFailureRetryInterval": 30
  },
  "driver": {
    "cores": 1,
    "memory": "1g",
    "serviceAccount": "spark",
    "labels": {
      "version": "4.0.0"
    },
    "envVars": {
      "AWS_ACCESS_KEY_ID": "minio",
      "AWS_SECRET_ACCESS_KEY": "minio123"
    },
    "envFrom": [],
    "volumeMounts": [],
    "volumes": []
  },
  "executor": {
    "cores": 1,
    "instances": 2,
    "memory": "2g",
    "labels": {
      "version": "4.0.0"
    },
    "envVars": {
      "AWS_ACCESS_KEY_ID": "minio",
      "AWS_SECRET_ACCESS_KEY": "minio123"
    },
    "volumeMounts": []
  },
  "monitoring": {
    "exposeDriverMetrics": false,
    "exposeExecutorMetrics": false,
    "prometheus": {
      "jmxExporterJar": "/opt/spark/jars/prometheus-jmx-exporter.jar",
      "configFile": "/etc/metrics/conf.yaml",
      "port": 8090
    }
  },
  "sparkConf": {
    "spark.hadoop.fs.s3a.access.key": "minio",
    "spark.hadoop.fs.s3a.secret.key": "minio123",
    "spark.hadoop.fs.s3a.endpoint": "https://cuong-dev.cloud:9000",
    "spark.hadoop.fs.s3a.path.style.access": "true",
    "spark.hadoop.fs.s3a.connection.ssl.enabled": "true"
  },
  "hadoopConf": {}
}
